// Prizm devcontainer. See .devcontainer/README.md for what runs here and what runs on the Mac.
{
  "name": "Prizm",
  // The container and the on-demand Vaultwarden rig are defined in compose.yaml.
  "dockerComposeFile": "compose.yaml",
  "service": "prizm-dev",
  // Start only the dev container; the rig services are also behind the "rig" profile.
  "runServices": ["prizm-dev"],
  // Closing VS Code must not stop prizm-dev under scripts/claude.sh, or the rig.
  "shutdownAction": "none",

  // The Compose default would be "/". Keep in sync with PRIZM_CONTAINER_WORKSPACE in
  // scripts/lib/common.sh.
  "workspaceFolder": "/workspaces/prizm",
  "remoteUser": "developer",
  "updateRemoteUserUID": true,

  "postCreateCommand": "bash .devcontainer/post-create.sh",

  "customizations": {
    "vscode": {
      "extensions": [
        "swiftlang.swift-vscode",
        "anthropic.claude-code",
        "timonwong.shellcheck",
        "github.vscode-github-actions",
        "redhat.vscode-yaml"
      ]
    }
  }
}
